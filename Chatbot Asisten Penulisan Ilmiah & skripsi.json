    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  let text = item.json.pageContent || item.json.text || item.json.data || '';\n\n  text = text.replace(/\\u0000/g, '').replace(/[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]/g, '');\n  \n  text = text.replace(/\\r\\n/g, '\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\n  \n  item.json.data = text;\n  item.json.text = text;\n  item.json.pageContent = text;\n}\n\nreturn $input.all();"
      },
